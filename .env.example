# Hweb Environment Variables
# Copy this file to .env.local and fill in your values

# Backend API URLs (required)
NEXT_PUBLIC_HCORE_URL=https://core-api.hanoled.com
NEXT_PUBLIC_HSMS_URL=https://api.hanoled.com
NEXT_PUBLIC_HCBT_URL=https://cbt-api.hanoled.com

# Google OAuth (optional)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Alternative CBT API URL (optional)
NEXT_PUBLIC_CBT_API_URL=

# --- Browser authentication mode -------------------------------------------
# Default ("bearer"): tokens are kept in localStorage and sent as a Bearer
# header. Required while this app and the APIs are on different registrable
# domains. Any XSS bug can read those tokens.
#
# "cookie": tokens live only in httpOnly cookies JavaScript cannot read. Only
# works when this app is served from the same parent domain as the APIs
# (e.g. app.hanoled.com -> *.hanoled.com). Set both together:
# NEXT_PUBLIC_AUTH_MODE=cookie
# AUTH_COOKIE_DOMAIN=.hanoled.com
# Then confirm each API's CORS_ORIGINS/FRONTEND_URL includes this app's exact origin.

# Sentry error reporting (off when the DSN is empty). No bodies, cookies,
# query strings or user details are sent, and there is no session replay.
NEXT_PUBLIC_SENTRY_DSN=
# Optional separate DSN for server-side errors; defaults to the public one.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0
# Build time only (Vercel/CI secrets): upload source maps for readable stacks.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
